// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id            String      @id @default(uuid()) @unique @db.Uuid
  firstName     String
  surname       String
  email         String      @unique
  passwordHash  String
  avatar        String      @default("")

  cv            Cv?         @relation(name: "CV")
  createdPosts  Post[]      @relation(name: "createdPosts")
  appliedTo     Post[]      @relation(name: "appliedTo")
  readPosts     Post[]      @relation(name: "readPosts")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}

model Cv {
  id            String      @id @default(uuid()) @unique @db.Uuid
  fileName      String
  fileType      String      @default("")
  fileSize      Int         @default(0)
  fileContent   Bytes       @db.ByteA @default("")

  account       Account     @relation(name: "CV", fields: [accountId], references: [id])
  accountId     String      @unique @db.Uuid

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}

model Post {
  id            String      @id @default(uuid()) @unique @db.Uuid
  jobName       String
  description   String
  wage          Float
  location      String
  expectedHours Float

  creator       Account     @relation(name: "createdPosts", fields: [creatorId], references: [id])
  creatorId     String      @db.Uuid
  applicants    Account[]   @relation(name: "appliedTo")
  readers       Account[]   @relation(name: "readPosts")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
}
